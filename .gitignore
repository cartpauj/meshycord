# Build output
/meshycord
/out/
/dist/
meshycord_*.deb
meshycord-*.rpm
meshycord_*.tar.gz

# Go
*.test
/vendor/
coverage.out
*.cover.out

# Editor and OS noise
.vscode/
.idea/
.DS_Store
*.swp
*~

# Planning docs stay local — working notes, not a deliverable.
PRD.md

# Nothing secret belongs in this repo. Runtime config and the Discord bot
# token live on the device, outside the source tree. If you add a local
# config or database for testing, exclude it here.
*.sqlite
*.sqlite-*
.env
.env.*

# Local runtime config only. Named rather than globbed as *.conf so that a
# committed sample or a packaging config is never silently excluded.
/meshycord.conf
*.local.conf
