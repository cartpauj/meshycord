[Unit]
Description=MeshyCord — MeshCore ↔ Discord bridge
Documentation=https://github.com/cartpauj/meshycord
After=network-online.target bluetooth.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
# Type=notify with a watchdog is the whole recovery story.
#
# The ESP32 version fed a hardware watchdog by hand from every loop that could
# run long, and missing one rebooted the device — which is exactly what
# happened. Here the supervision lives outside the process: a goroutine with
# nothing else to do pings systemd, and if the process wedges systemd restarts
# it. Nothing in the application has to remember anything.
Type=notify
WatchdogSec=120
NotifyAccess=main

# MeshyCord runs as root for one reason: it opens the serial port the radio is
# on (/dev/ttyACM*, /dev/ttyUSB*), and on a stock Raspberry Pi OS install those
# belong to the dialout group. Running as root means it works regardless of
# group membership, and the hardening below mitigates the privilege.
#
# To run unprivileged instead, create a `meshycord` user, add it to `dialout`
# (and `bluetooth` if you use BLE), chown /var/lib/meshycord to it, and change
# User=/Group= here.
User=root
Group=root

ExecStart=/usr/bin/meshycord \
    -listen 0.0.0.0:9150 \
    -db /var/lib/meshycord/db.sqlite

Restart=always
RestartSec=5
LimitNOFILE=4096

# NOTE: no CapabilityBoundingSet here on purpose. Narrowing it to just
# CAP_NET_BIND_SERVICE would drop CAP_DAC_OVERRIDE, which is exactly what lets
# root open a serial port owned root:dialout mode 660 — so it would break the
# recommended transport in exchange for nothing. The console port is 9150,
# which is unprivileged, so no capability is needed at all.

# Hardening
#
# DELIBERATELY ABSENT — do not add these without re-testing the radio link:
#   * PrivateDevices=yes   mounts a minimal private /dev that hides /dev/tty*,
#                          which breaks the serial transport entirely.
#   * DevicePolicy=closed  (and any DeviceAllow= list) restricts device access
#                          to an allow-list; the node can appear on any of
#                          several tty classes, so device access is left at the
#                          permissive default.
#
# ProtectSystem=strict is fine: it leaves /dev, /proc and /sys alone and only
# makes the filesystem tree read-only.
#
# AF_BLUETOOTH is required for the BLE transport. AF_UNIX is required for the
# D-Bus connection BlueZ pairing goes through, and for the systemd notify
# socket.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/meshycord
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_BLUETOOTH AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible

# The database holds the bot token and every room-server password. Nothing else
# on the box has any business reading it.
UMask=0077

[Install]
WantedBy=multi-user.target
